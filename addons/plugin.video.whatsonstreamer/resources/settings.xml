<?xml version="1.0" encoding="utf-8"?>
<settings>
  <category label="SIMKL">
    <setting id="client_id"
             type="text"
             label="SIMKL Client ID (API Key)"
             default=""/>
    <setting id="show_posters"
             type="bool"
             label="Show posters (SIMKL images)"
             default="true"/>
    <setting id="access_token"
             type="text"
             label="SIMKL Access Token (auto)"
             default=""
             enable="false"/>
  </category>

  <category label="AllDebrid">
    <setting id="alldebrid_api_key"
             type="text"
             label="AllDebrid API Key"
             default=""/>
  </category>

  <category label="Local Media">
    <setting id="local_media_path"
             type="text"
             label="Series base folder (e.g. C:\media\series)"
             default=""/>
  </category>

  <category label="TMDB">
    <setting id="tmdb_api_key"
             type="text"
             label="TMDB API Key (v3)"
             default=""/>
    <setting id="airdate_source"
             type="enum"
             label="Episode airdate source"
             values="SIMKL|TMDB"
             default="1"/>
  </category>

  <category label="IPTV">
    <setting id="iptv_base_url"
             type="text"
             label="IPTV provider base URL (no path)"
             default=""/>
    <setting id="iptv_username"
             type="text"
             label="IPTV username"
             default=""/>
    <setting id="iptv_password"
             type="text"
             label="IPTV password"
             default=""
             option="hidden"/>
    <setting id="iptv_vod_enabled"
             type="bool"
             label="Enable IPTV movie (VOD) lookup"
             default="true"/>
    <setting id="iptv_series_enabled"
             type="bool"
             label="Enable IPTV series lookup"
             default="true"/>
    <setting id="iptv_catalog_ttl_hours"
             type="number"
             label="IPTV catalog cache TTL (hours)"
             default="24"/>
  </category>

  <category label="Live TV - Playlist &amp; EPG">
    <setting id="livetv_playlist_source" type="enum" label="Playlist source" values="Download (URL)|Local file" default="0" />
    <setting id="livetv_m3u_path" type="text" label="M3U path (uses the IPTV credentials above)" default="/get.php" />
    <setting id="livetv_m3u_type" type="text" label="Playlist type (m3u or m3u_plus)" default="m3u_plus" />
    <setting id="livetv_output" type="text" label="Output format (ts or m3u8)" default="ts" />
    <setting id="livetv_playlist_timeout" type="number" label="Playlist fetch timeout (seconds)" default="600" />
    <setting id="livetv_playlist_retries" type="number" label="Playlist fetch retries" default="3" />
    <setting id="livetv_local_playlist_path" type="text" label="Local playlist file (.m3u)" default="special://profile/addon_data/plugin.video.whatsonstreamer/playlist.m3u" />
    <setting id="livetv_epg_enabled" type="bool" label="Enable EPG" default="true" />
    <setting id="livetv_epg_source" type="enum" label="EPG source" values="Download (URL)|Local file" default="0" />
    <setting id="livetv_epg_path" type="text" label="EPG path (uses the IPTV credentials above)" default="/xmltv.php" />
    <setting id="livetv_epg_timeout" type="number" label="EPG fetch timeout (seconds)" default="600" />
    <setting id="livetv_epg_ttl" type="number" label="EPG cache TTL (minutes)" default="180" />
    <setting id="livetv_epg_use_conditional_get" type="bool" label="Use conditional GET (ETag/Last-Modified)" default="true" />
    <setting id="livetv_local_epg_path" type="text" label="Local EPG file (.xml)" default="special://profile/addon_data/plugin.video.whatsonstreamer/epg.xml" />
  </category>

  <category label="Live TV - Personalization">
    <setting id="livetv_recent_max" type="number" label="Max Recently Watched" default="50" />
    <setting id="livetv_on_now_pinned_recent" type="number" label="Pinned recents on On Now" default="8" />
    <setting id="livetv_coming_up_hours" type="number" label="Coming Up horizon (hours)" default="5" />
  </category>

  <category label="Live TV - Channel Filtering">
    <setting id="livetv_drop_vod" type="bool" label="Drop VOD / series / movies" default="true" />
    <setting id="livetv_include_groups" type="text" label="Include groups (comma-separated)" default="" />
    <setting id="livetv_exclude_groups" type="text" label="Exclude groups (comma-separated)" default="Adult,XXX" />
    <setting id="livetv_include_keywords" type="text" label="Include keywords (comma-separated)" default="" />
    <setting id="livetv_exclude_keywords" type="text" label="Exclude keywords (comma-separated)" default="" />
    <setting id="livetv_include_regex" type="text" label="Include regex (optional)" default="" />
    <setting id="livetv_exclude_regex" type="text" label="Exclude regex (optional)" default="" />
  </category>

  <category label="Live TV - Performance">
    <setting id="livetv_auto_update_enabled" type="bool" label="Auto-update local files" default="false" />
    <setting id="livetv_auto_update_mode" type="enum" label="Auto-update schedule" values="Once per day at time|Every X hours" default="1" />
    <setting id="livetv_auto_update_time" type="text" label="Daily update time (HH:MM, 24h)" default="02:00" visible="eq(-1,0)" />
    <setting id="livetv_auto_update_interval_hours" type="number" label="Update interval (hours)" default="6" visible="eq(-2,1)" />
    <setting id="livetv_auto_update_notify" type="bool" label="Notify during auto-update" default="true" />
    <setting id="livetv_cache_ttl" type="number" label="Playlist cache TTL (minutes)" default="10" />
    <setting id="livetv_page_size" type="number" label="Page size (items per page)" default="200" />
    <setting id="livetv_max_search_results" type="number" label="Max search results" default="200" />
  </category>

  <category label="Advanced">
    <setting id="debug_logging" type="bool" label="Debug logging (all modules: SIMKL, TMDB, Live TV)" default="false" />
    <setting id="livetv_use_local_cache_files" type="bool" label="DEBUG: Use local cache files instead of web downloads" default="false" />
    <setting id="livetv_local_cache_base_path" type="text" label="DEBUG: Local cache folder" default="" />
    <setting id="livetv_local_cache_playlist_file" type="text" label="DEBUG: Playlist cache filename" default="playlist-online.m3u" />
    <setting id="livetv_local_cache_epg_file" type="text" label="DEBUG: EPG cache filename" default="epg-online.xml" />
  </category>
</settings>
